# LLM Provider Configuration
# Options: opencode (default, free), openai, anthropic, openrouter, local, gemini
LLM_PROVIDER=opencode

# Model (leave empty for default per provider)
LLM_MODEL=

# API Key (only needed for non-opencode providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional settings
LLM_TEMPERATURE=0.2
MAX_ITERATIONS=10
WORK_DIR=/workspaces/empty/coding-agent
